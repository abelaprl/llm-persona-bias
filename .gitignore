# Environment files
.env
.env.local
.venv/
.venv_parse/
venv/
venv-llama/
env/
ENV/
pyvenv.cfg

# Optional common ignores
__pycache__/
*.pyc
.vscode/
.idea/
node_modules/

# Local agent and notebook runtimes
/.claude/settings.local.json
/config/model_keys.json
/.codex
/.codex_tmp/
/codex/
/.jupyter_runtime/
/.tmp*/
/_pdf_preview/
/temp_table_vi4*.png

# Local reference documents (not part of the repository)
/docs/ref/

# Keep new Markdown notes local; existing tracked documentation is unaffected.
/docs/**/*.md

# Data/outputs and temporary directories
logs_*.txt
src/result/
backup_*/
*.tar.gz
*.zip

# Log files
*.log

# Large local artifacts (do not commit)
data/*.parquet
data/SQuAD_train.json
data/**/*.parquet
data/squad/SQuAD_train.json
result/reports/results_all_models_all_personas.csv
result/reports/results_all_models_all_personas*.csv
result/reports/results_12_models_all_personas.csv
result/reports/all_results_combined.csv
result/reports/all_results_gsm8k_lite.csv

# Ignore generated result CSVs and large per-model result folders
/result/**/*.csv
/result/**/result_ethics_*.csv

# Keep only these audited selective-rerun manifests portable to Vast instances.
!/result/rerun_manifests/ethics_v9/deepseek_http_4xx_5xx.csv
!/result/rerun_manifests/ethics_v9/deepseek_non_http_local_connection.csv
!/result/rerun_manifests/gsm8k_deepseek/*.csv
!/result/rerun_manifests/qwen3_next_80b_nonregional/*.csv
!/result/rerun_manifests/qwen3_next_80b_regional/*.csv

# Ignore invalid regional cultural GSM8K outputs for unavailable AllenAI OLMo endpoint
/result/GMS8K/regional_cultural_persona/allenai_olmo-3.1-32b-instruct/

# Disposable experiment workspaces and rerun backups
/result/ETHICS/pilot test/
/result/**/_merge_backup/
/result/**/_rebuild_preview/
/result/**/_report_backup/
/result/**/_rerun_attempts/
/result/**/_rerun_backup/
/result/**/_rerun_success/
/result/**/incomplete_attempts/
/result/test_tmp*/
/result/tmp*/

# Sisa build pip (percobaan `pip install vllm` di Windows, ~18k file / 550 MB).
# Bukan bagian eksperimen; aman dihapus kapan saja.
/t/

# Artefak Windows dan backup editor
*.lnk
*.bak

