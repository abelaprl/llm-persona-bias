* text=auto

# Keep source and research metadata stable across Windows/Linux runners.
*.csv text eol=lf
*.ipynb text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.py text eol=lf
*.tex text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary research artifacts.
*.docx binary
*.gz binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.pptx binary
*.xlsx binary
*.zip binary

# Lossless compact CSV archives.
*.zst binary
